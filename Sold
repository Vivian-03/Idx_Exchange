# This flags records where ListingContractDate is after PurchaseContractDate OR any date is after CloseDate
sold['negative_timeline_flag'] = (
    (sold['listing_after_close_flag'] == True) |
    (sold['purchase_after_close_flag'] == True) |
    ((sold['ListingContractDate'] > sold['PurchaseContractDate']) &
     (sold['ListingContractDate'].notna()) &
     (sold['PurchaseContractDate'].notna()))
)


