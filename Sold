listing_residential = pd.read_csv('C:/IDX EXCHANGE/Listing_Residential.csv', encoding ='latin1', low_memory=False)
#calculate missing stats
missing_counts = sold_residential.isnull().sum()
missing_percent = (missing_counts / len(sold_residential)) * 100

#create summary DataFrame
missing_summary = pd.DataFrame({
    'Column': sold_residential.columns,
    'Missing_Count': missing_counts,
    'Missing_Percent': missing_percent,
    'Flag_>90%': missing_percent > 90
    })

#filter to show only flagged columns
flagged = missing_summary[missing_summary['Flag_>90%'] == True]
print(flagged)

#drop missing value over 90
cols_to_drop = flagged['Column'].tolist()
sold_residential_cleaned = sold_residential.drop(columns=cols_to_drop)
print (f'\nDropped{len(cols_to_drop)}colummns from sold_residential')
print(f'New Shape: {sold_residential_cleaned.shape}')
print(f'Columns: {sold_residential_cleaned.columns}')

cols_to_drop = flagged['Column'].tolist()
listing_residential_cleaned = listing_residential.drop(columns=cols_to_drop)
print (f'\nDropped{len(cols_to_drop)}colummns from listing_residential')

sold_residential_cleaned.to_csv("Sold_Residential_Cleaned.csv", index= False)

#Mortage Rate enrichment
import pandas as pd
sold = pd.read_csv('C:/IDX EXCHANGE/Sold_Residential_Cleaned.csv', encoding = 'latin1', low_memory=False)
listings = pd.read_csv ('C:/IDX EXCHANGE/Listing_Residential_Cleaned.csv', encoding = 'latin1', low_memory=False)

url = "https://fred.stlouisfed.org/graph/fredgraph.csv?id=MORTGAGE30US"
mortgage = pd.read_csv(url, parse_dates=['observation_date'])
mortgage.columns = ['date', 'rate_30yr_fixed']
# Step 2 – Resample weekly rates to monthly averages
mortgage['year_month'] = mortgage['date'].dt.to_period('M')
mortgage_monthly = (mortgage.groupby('year_month')['rate_30yr_fixed'].mean().reset_index())

# Step 3 – Create a matching year_month key on the MLS datasets
# Sold dataset — key off CloseDate
sold['year_month'] = pd.to_datetime(sold['CloseDate']).dt.to_period('M')
# Listings dataset — key off ListingContractDate
listings['year_month'] = pd.to_datetime(listings['ListingContractDate']).dt.to_period('M')

# Step 4 – Merge
sold_with_rates = sold.merge(mortgage_monthly, on='year_month', how='left')
listings_with_rates = listings.merge(mortgage_monthly, on='year_month', how='left')

# Step 5 – Validate the merge
# Check for any unmatched rows (rate should not be null)
print(sold_with_rates['rate_30yr_fixed'].isnull().sum())
print(listings_with_rates['rate_30yr_fixed'].isnull().sum())

# Preview
print(sold_with_rates[['CloseDate', 'year_month', 'ClosePrice', 'rate_30yr_fixed']].head())
print(listings_with_rates[['CloseDate', 'year_month', 'ClosePrice', 'rate_30yr_fixed']].head())

#saving as CSV

sold_with_rates.to_csv("Sold_with_rates.csv", index = False)
listings_with_rates.to_csv("Listings_with_rates.csv", index = False)

