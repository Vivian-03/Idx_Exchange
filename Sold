# Create boolean flag columns
# Flag 1: ListingContractDate should NOT be after CloseDate
sold['listing_after_close_flag'] = (
    (sold['ListingContractDate'] > sold['CloseDate']) &
    (sold['ListingContractDate'].notna()) &
    (sold['CloseDate'].notna())
)

# Flag 2: PurchaseContractDate should NOT be after CloseDate
sold['purchase_after_close_flag'] = (
    (sold['PurchaseContractDate'] > sold['CloseDate']) &
    (sold['PurchaseContractDate'].notna()) &
    (sold['CloseDate'].notna())
)

# Flag 3: Overall negative timeline (any order violation)
# This flags records where ListingContractDate is after PurchaseContractDate OR any date is after CloseDate
sold['negative_timeline_flag'] = (
    (sold['listing_after_close_flag'] == True) |
    (sold['purchase_after_close_flag'] == True) |
    ((sold['ListingContractDate'] > sold['PurchaseContractDate']) &
     (sold['ListingContractDate'].notna()) &
     (sold['PurchaseContractDate'].notna()))
)


# This flags when dates are not in order: Listing <= Purchase <= Close
sold['negative_timeline_flag'] = (
    ~(
        (sold['ListingContractDate'] <= sold['PurchaseContractDate']) &
        (sold['PurchaseContractDate'] <= sold['CloseDate'])
    ) &
    (sold['ListingContractDate'].notna()) &
    (sold['PurchaseContractDate'].notna()) &
    (sold['CloseDate'].notna())
)

