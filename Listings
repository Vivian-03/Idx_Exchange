property_type = listing.groupby('PropertyType')[metrics].agg(['mean', 'median', 'count', 'std'])
print("\nBy PropertyType:")
print(property_type)

property_subtype = listing.groupby('PropertySubType')[metrics].agg(['mean', 'median','count', 'std'])
print("\nBy PropertySubType:")
