           'days_on_market', 'listing_to_contract_days', 'contract_to_close_days', 'ClosePrice']


# Create a subset DataFrame with only the calculated columns
metrics_df = listing[['price_ratio', 'price_per_sq_ft', 'Year', 'Month', 'YrMo', 
                   'close_to_original_list_ratio', 'listing_to_contract_days', 
                   'contract_to_close_days']].head(10)

print(metrics_df)




