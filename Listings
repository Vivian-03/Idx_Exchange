import pandas as pd
import numpy as np
listing = pd.read_csv("C:\IDX EXCHANGE\Listing_FINAL_CLEANED.csv", encoding = 'latin1', low_memory=False)


# Convert date columns to datetime
listing['ListingContractDate'] = pd.to_datetime(listing['ListingContractDate'], errors='coerce')
listing['PurchaseContractDate'] = pd.to_datetime(listing['PurchaseContractDate'], errors='coerce')
listing['CloseDate'] = pd.to_datetime(listing['CloseDate'], errors='coerce')

# Calculate price ratios
listing['price_ratio'] = listing['ClosePrice'] / listing['OriginalListPrice']
listing['price_per_sq_ft'] = (listing['ClosePrice'] / listing['LivingArea']).where(listing['LivingArea'] > 0, np.nan)
listing['close_to_original_list_ratio'] = listing['ClosePrice']/listing['OriginalListPrice']
# Calculate days on market 
listing['days_on_market'] = listing['DaysOnMarket']

# Extract date components
listing['Year'] = listing['CloseDate'].dt.year
listing['Month'] = listing['CloseDate'].dt.month
listing['YrMo'] = listing['CloseDate'].dt.strftime('%Y-%m')

# Calculate days between dates 
listing['listing_to_contract_days'] = (listing['PurchaseContractDate'] - listing['ListingContractDate']).dt.days
listing['contract_to_close_days'] = (listing['CloseDate'] - listing['PurchaseContractDate']).dt.days  







